# Copy to keystore.properties (gitignored) and fill in the two passwords. Never commit the real file.
# Same upload keystore as the VOID UI icon pack. It holds two keys: void_ui_release (22 Mar 2026)
# and voidui (24 Mar 2026). With Play App Signing, Google holds the real app-signing key, so one
# upload key can serve both apps. Pick ONE alias for this app and keep using it for every upload.
storeFile=C:/Users/User/Documents/Android/Keystores/void_ui_release.jks
storePassword=
keyAlias=void_ui_release
keyPassword=
