<?xml version="1.0" encoding="utf-8"?>
<!-- void phone adaptive-icon foreground: the "void" ring (a home-screen tile) with a terminal
     prompt inside. 108x108 canvas; everything sits inside the 66dp safe zone (radius 33) so no
     launcher mask shape can clip it. Also used as the monochrome (themed icon) layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- soft glow behind the ring -->
    <path
        android:pathData="M54,27a27,27 0 1,0 0,54a27,27 0 1,0 0,-54z"
        android:strokeColor="#3B82F6"
        android:strokeAlpha="0.22"
        android:strokeWidth="6.5" />

    <!-- the ring -->
    <path
        android:pathData="M54,27a27,27 0 1,0 0,54a27,27 0 1,0 0,-54z"
        android:strokeColor="#3B82F6"
        android:strokeWidth="2.6" />

    <!-- terminal prompt ">" -->
    <path
        android:pathData="M43.5,46L51,54L43.5,62"
        android:strokeColor="#60A5FA"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- terminal prompt "_" cursor -->
    <path
        android:pathData="M55,62L64.5,62"
        android:strokeColor="#60A5FA"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
</vector>
